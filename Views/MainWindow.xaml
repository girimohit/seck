<Window x:Class="SecureAppLocker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SecureAppLocker.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Secure App Locker"
                   FontSize="24"
                   Margin="0,0,0,20"/>

            <TextBlock Text="Running Apps"/>

            <ListBox ItemsSource="{Binding RunningApps}"
                 SelectedItem="{Binding SelectedApp}"
                 Width="300" Height="150"/>

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <Button Content="Lock"
                    Command="{Binding LockCommand}"
                    Width="100" Margin="5"/>
                <Button Content="Unlock"
                    Command="{Binding UnlockCommand}"
                    Width="100" Margin="5"/>
                <Button Content="Change Password"
                    Command="{Binding ChangePasswordCommand}"
                    Width="200"
                    Margin="0,10,0,0"/>
            </StackPanel>

            <TextBlock Text="Locked Apps" Margin="0,20,0,0"/>

            <ListBox ItemsSource="{Binding LockedApps}"
                 Width="300" Height="100"/>
        </StackPanel>
    </Grid>
</Window>
