<Window x:Class="SecLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SecLock"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
	<Grid>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

        <TextBlock Text="Secure App Locker"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <ListBox ItemsSource="{Binding RunningApps}"
                 SelectedItem="{Binding SelectedApp}"
                 Width="300"
                 Height="200"/>

        <Button Content="Kill Selected App"
                Command="{Binding KillAppCommand}"
                Width="200"
                Height="40"
                Margin="0,20,0,0"/>
    </StackPanel>
</Grid>
</Window>
